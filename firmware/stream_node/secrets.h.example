// Copy this file to secrets.h and fill in your hotspot credentials.
// secrets.h is gitignored - credentials never reach the repo.
//
// Use the PHONE HOTSPOT you intend to bring to the venue (PLAN.md §1 item 7),
// not home WiFi. The point is to prove the exact network you will rely on.
// ESP32 is 2.4 GHz only - if your phone offers a 5 GHz band, disable it or use
// the compatibility / "Maximise compatibility" toggle.

#define WIFI_SSID     ""
#define WIFI_PASSWORD ""

// Hostname this node advertises for OTA. Give the two nodes different names.
#define OTA_HOSTNAME  "quake-node-a"
